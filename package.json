{
  "name": "juniorcode",
  "version": "0.1.0",
  "private": true,
  "description": "JuniorCode — Marketplace + Learn Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "turbo": "^2.9.18",
    "typescript": "^5.4.5"
  },
  "pnpm": {
    "overrides": {
      "js-yaml": "^4.2.0",
      "postcss": "^8.5.10"
    }
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
